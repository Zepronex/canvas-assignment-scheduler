{
  "manifest_version": 3,
  "name": "Canvas Deadline Copilot",
  "description": "Privacy-first Canvas deadline tracking for Chrome.",
  "version": "0.1.0",
  "action": {
    "default_title": "Canvas Deadline Copilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["alarms", "notifications", "storage"],
  "optional_host_permissions": ["https://*/*"]
}
